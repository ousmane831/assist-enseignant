# Copier en .env (jamais versionné). DEBUG=0 + SECRET_KEY obligatoire pour un test avec de vrais enseignants.
DEBUG=1
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Durée de vie d'une session, en jours (au-delà, reconnexion obligatoire)
TOKEN_DUREE_JOURS=30
# PostgreSQL (obligatoire)
POSTGRES_DB=assistant_enseignant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
